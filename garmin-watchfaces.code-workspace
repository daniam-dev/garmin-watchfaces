{
  "folders": [
    { "name": "Repositorio", "path": "." },
    { "name": "Modular One", "path": "watchfaces/modular-one" },
    { "name": "Pilot Analog", "path": "watchfaces/pilot-analog" },
    { "name": "Stride Digital", "path": "watchfaces/stride-digital" }
  ],
  "extensions": {
    "recommendations": ["garmin.monkey-c"]
  },
  "settings": {
    "files.encoding": "utf8",
    "files.insertFinalNewline": true,
    "files.trimTrailingWhitespace": true,
    "files.exclude": { "**/bin": true, "**/.local": true },
    "search.exclude": { "**/bin": true, "**/.local": true }
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Compilar Modular One (fr170)",
        "type": "process",
        "command": "powershell.exe",
        "args": [
          "-NoProfile", "-File",
          "${workspaceFolder:Modular One}/../../scripts/build.ps1",
          "-Project", "modular-one"
        ],
        "options": { "cwd": "${workspaceFolder:Modular One}" },
        "group": { "kind": "build", "isDefault": true },
        "problemMatcher": []
      },
      {
        "label": "Compilar Pilot Analog (fr170)",
        "type": "process",
        "command": "powershell.exe",
        "args": [
          "-NoProfile", "-File",
          "${workspaceFolder:Pilot Analog}/../../scripts/build.ps1",
          "-Project", "pilot-analog"
        ],
        "options": { "cwd": "${workspaceFolder:Pilot Analog}" },
        "group": "build",
        "problemMatcher": []
      },
      {
        "label": "Compilar Stride Digital (fr170)",
        "type": "process",
        "command": "powershell.exe",
        "args": ["-NoProfile", "-File", "${workspaceFolder:Stride Digital}/../../scripts/build.ps1", "-Project", "stride-digital"],
        "options": { "cwd": "${workspaceFolder:Stride Digital}" },
        "group": "build",
        "problemMatcher": []
      },
      {
        "label": "Verificar estructura",
        "type": "process",
        "command": "powershell.exe",
        "args": ["-NoProfile", "-File", "${workspaceFolder:Repositorio}/scripts/verify.ps1"],
        "options": { "cwd": "${workspaceFolder:Repositorio}" },
        "problemMatcher": []
      },
      {
        "label": "Compilar todas (fr170)",
        "type": "process",
        "command": "powershell.exe",
        "args": ["-NoProfile", "-File", "${workspaceFolder:Repositorio}/scripts/build.ps1", "-Project", "all"],
        "options": { "cwd": "${workspaceFolder:Repositorio}" },
        "group": "build",
        "problemMatcher": []
      },
      {
        "label": "Probar herramientas",
        "type": "process",
        "command": "powershell.exe",
        "args": ["-NoProfile", "-File", "${workspaceFolder:Repositorio}/tests/tooling.tests.ps1"],
        "options": { "cwd": "${workspaceFolder:Repositorio}" },
        "problemMatcher": []
      }
    ]
  }
}
